<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="#0e1116">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XenonLabs"
        android:textColor="#4d6bfe"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/widget_last_reply"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Open XenonLabs and start chatting"
        android:textColor="#e8ecf1"
        android:textSize="12sp"
        android:maxLines="5"
        android:ellipsize="end" />

    <Button
        android:id="@+id/widget_new_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New chat"
        android:textSize="12sp"
        android:background="#4d6bfe"
        android:textColor="#ffffff"
        android:padding="6dp" />
</LinearLayout>
