<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Adaptive icon safe zone: the central 72×72 area (18..90 in both axes).
      Everything here lives well inside that.
    -->
    <group android:translateX="27" android:translateY="27">
        <!-- Letter X built from two thick rounded strokes.
             Total width/height = 54, giving 9dp margin inside safe zone. -->
        <path
            android:fillColor="#ffffff"
            android:pathData="M5,5 L49,49 L49,49 L49,49 Z"
            android:strokeWidth="0" />

        <!-- Top-left to bottom-right diagonal -->
        <path
            android:pathData="M8,4 L50,50"
            android:strokeColor="#ffffff"
            android:strokeWidth="10"
            android:strokeLineCap="round" />

        <!-- Top-right to bottom-left diagonal -->
        <path
            android:pathData="M50,4 L8,50"
            android:strokeColor="#ffffff"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
    </group>
</vector>
